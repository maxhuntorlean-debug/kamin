{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kamin",
  "version": "0.1.0",
  "identifier": "app.kamin.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Kamin",
        "width": 1080,
        "height": 760,
        "minWidth": 880,
        "minHeight": 640,
        "backgroundColor": "#f3f5f4"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost http://localhost:1430 ws://localhost:1430 ws://localhost:1431 https://api.openai.com; img-src 'self' data: blob:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
